Bundle-Name: Eclipse Fennec Stream Model
Bundle-Description: Fennec change-stream metamodel (ChangeSet/ChangeEntry/DeltaKind and \
	the snapshot chain) — the wire/log format of the Fennec change stream (see docs/source/concept.md §5, §20). \
	Promoted from the concept draft; evolution is additive-only.

src=${^src},src-gen

-workingset: streaming

-library: enableEMF

-generate:\
	model/stream.genmodel;\
		generate=fennecEMF;\
		genmodel=model/stream.genmodel;\
		output=src-gen

-includeresource.model: model=model

-buildpath: \
	org.osgi.service.condition;version=latest

-testpath: \
	assertj-core
