# Reference example of the change stream: the leisure pool demo of emf.ogc.features, its pools fed
# with water temperature and pH by simulated sensors through a stream mapping and update commands.
# OGC API Features on http://localhost:8080/ogc, the map on http://localhost:8080/ogc/viewer/.
#   ./gradlew :org.eclipse.fennec.stream.example.pool:run.pool

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.stream.example.pool',\
	bnd.identity;id='org.eclipse.fennec.stream.osgi',\
	bnd.identity;id='org.eclipse.fennec.stream.persistence',\
	bnd.identity;id='org.eclipse.fennec.mapping.osgi',\
	bnd.identity;id='org.eclipse.fennec.mapping.ocl',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.eobject.registry',\
	bnd.identity;id='org.eclipse.fennec.m2x.ocl.engine',\
	bnd.identity;id='org.eclipse.fennec.m2x.ocl.parser',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.example.bath.demo',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.example.bath',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.example.city',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.runtime',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.viewer',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.source.persistence',\
	bnd.identity;id='org.eclipse.fennec.codec.cql2',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.cql2',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.geo',\
	bnd.identity;id='org.eclipse.fennec.codec.geojson',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.metadata',\
	bnd.identity;id='org.eclipse.fennec.persistence.eclipselink',\
	bnd.identity;id='org.eclipse.fennec.persistence.repository.jpa',\
	bnd.identity;id='org.eclipse.persistence.asm',\
	bnd.identity;id='org.eclipse.persistence.jpa.jpql',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.postgresql',\
	bnd.identity;id='org.postgresql.jdbc',\
	bnd.identity;id='com.h2database',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
	bnd.identity;id='org.apache.felix.http.jetty12',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.shell.remote'

-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runfw: org.apache.felix.framework
-runee: JavaSE-21

# Copy the bundles into the framework cache: with reference: URLs a snapshot refreshed in
# ~/.m2 while the demo runs breaks class loading (ClassFormatError: Incompatible magic value)
-runnoreferences: true

# the shared configuration plus the data source; bath-postgres.bndrun swaps the data source
demo.config = ${fileuri;${.}/config/pool-example.json},${fileuri;${.}/config/datasource-h2.json}

-runproperties: \
	org.osgi.service.http.port=8080,\
	gosh.args=--nointeractive,\
	osgi.shell.telnet.ip=127.0.0.1,\
	osgi.shell.telnet.port=6666,\
	configurator.initial="${demo.config}"
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.22.0,2.22.1)',\
	com.h2database;version='[2.3.232,2.3.233)',\
	jakarta.persistence-api;version='[3.2.0,3.2.1)',\
	net.opengis.cql2.model;version='[0.1.0,0.1.1)',\
	org.antlr.antlr4-runtime;version='[4.13.2,4.13.3)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.http.jetty12;version='[1.0.34,1.0.35)',\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.apache.felix.shell.remote;version='[1.2.0,1.2.1)',\
	org.eclipse.daanse.jdbc.datasource.common;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.datasource.h2;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.datasource.postgresql;version='[0.0.1,0.0.2)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.atlas.configuration.model;version='[1.0.0,1.0.1)',\
	org.eclipse.fennec.codec;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.cql2;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.geojson;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.command.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.eobject.registry;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.metadata;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.expression.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.m2x.ocl.api;version='[0.1.1,0.1.2)',\
	org.eclipse.fennec.m2x.ocl.engine;version='[0.1.1,0.1.2)',\
	org.eclipse.fennec.m2x.ocl.model;version='[0.1.1,0.1.2)',\
	org.eclipse.fennec.m2x.ocl.parser;version='[0.1.1,0.1.2)',\
	org.eclipse.fennec.m2x.unit;version='[0.1.1,0.1.2)',\
	org.eclipse.fennec.mapping;version=snapshot,\
	org.eclipse.fennec.mapping.model;version=snapshot,\
	org.eclipse.fennec.mapping.ocl;version=snapshot,\
	org.eclipse.fennec.mapping.osgi;version=snapshot,\
	org.eclipse.fennec.ogc.features.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.ogc.features.cql2;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.ogc.features.example.bath;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.ogc.features.example.bath.demo;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.ogc.features.example.city;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.ogc.features.geo;version='[0.1.0,0.1.1)',\
