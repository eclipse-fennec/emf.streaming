-library: enableOSGi-Test

-runfw: org.apache.felix.framework
-runee: JavaSE-21

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.stream.persistence.tests',\
	bnd.identity;id='org.eclipse.fennec.stream.persistence',\
	bnd.identity;id='org.eclipse.fennec.stream.osgi',\
	bnd.identity;id='org.eclipse.fennec.mapping.osgi',\
	bnd.identity;id='org.eclipse.fennec.mapping.ocl',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.eobject.registry',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.metadata',\
	bnd.identity;id='org.eclipse.fennec.m2x.ocl.engine',\
	bnd.identity;id='org.eclipse.fennec.m2x.ocl.parser',\
	bnd.identity;id='org.eclipse.fennec.persistence.eclipselink',\
	bnd.identity;id='org.eclipse.fennec.persistence.repository.jpa',\
	bnd.identity;id='org.eclipse.persistence.asm',\
	bnd.identity;id='org.eclipse.persistence.jpa.jpql',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='com.h2database',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='assertj-core'

-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runbundles.test: \
	org.eclipse.fennec.stream.persistence.tests;version=snapshot
